PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifelink?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:8443
DEFAULT_COUNTRY_CODE=+91
# Used by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9999999999
